# Public base URL used for metadata, robots.txt, and sitemap.xml.
# Use the official hostname when building a release.
NEXT_PUBLIC_SITE_URL=https://codeutsava.nitrr.ac.in

# Server-side countdown read endpoint. Start requests go directly to /server/setcounter/
# on the deployed origin to preserve Django session and CSRF cookies.
COUNTDOWN_API_BASE_URL=https://codeutsava.nitrr.ac.in/server
